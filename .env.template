# Copy to .env and fill in. Compose reads .env automatically.
#   cp .env.template .env

# --- MongoDB ---------------------------------------------------------------
# Credentials the mongo container is created with. Set them BEFORE first boot:
# they are only applied when the data volume is empty.
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change_me
MONGO_DB=mapa-ciencia-db
# 'mongo' = the compose service name. Use localhost only when running the API
# outside Docker against a local mongo.
MONGO_HOST=mongo
# Used both for the host port mapping and the in-network connection. Keep 27017
# unless 27017 is already taken on the host.
MONGO_PORT=27017

# --- API auth --------------------------------------------------------------
# Required. The app refuses to start if any of these three are empty.
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=change_me
JWT_SECRET=change_me_to_a_long_random_string

# --- Application -----------------------------------------------------------
API_PORT=8000

# --- Model keys (optional) -------------------------------------------------
# Leave blank to deploy. Browsing researchers, projects, articles and the graph
# works without them. Only on-demand embedding/summary generation needs them.
GEMINI_API_KEY=
INTERNAL_SWAGGER_KEY=

# --- Ollama (optional, remote inference server) ----------------------------
OLLAMA_HOST=https://chat.ccad.unc.edu.ar/
OLLAMA_API_KEY=

# Local embedding service, if one is running. Not required for browsing.
LOCAL_EMBEDDING_HOST=http://localhost:2904

# --- Defaults for visualization --------------------------------------------
# These must match the tags/models present in the restored dump.
DEFAULT_EMBEDDING_TAG=embeddings_profile_and_areas_complete_v1
DEFAULT_EMBEDDING_MODEL=gemini-embedding-001
DEFAULT_SUMMARY_TAG=complete
DEFAULT_SUMMARY_MODEL=gemini-2.5-pro
